             )
             # Clean up lookup future in scheduler adapter
             self.scheduler_adapter.cleanup_lookup_result(request.request_id)
+
+            # Admission is the one-shot transition out of PREFETCHING.
+            # Release the unused replay tail here, not during lookup polling:
+            # allocation may be retried and must not decrement readers twice.
+            if (
+                self._lookup_replay_tokens
