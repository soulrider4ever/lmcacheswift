@@ -1324,7 +1336,20 @@
 
         assert ret % self.scheduler_adapter.lmcache_tokens_per_chunk == 0
 
+        # Keep the full remote match for STORE accounting. Truncating the
+        # lookup itself would hide an already stored tail and re-offload it.
         tracker.num_stored_tokens = ret
+        if self._lookup_replay_tokens:
+            token_ids = tracker.get_token_ids()
