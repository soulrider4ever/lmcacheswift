@@ -449,6 +449,10 @@ class _SubpagedAttentionViewEdit(KVCacheGroupEdit):
         num_heads, head_size = _synthetic_attention_shape(
             elems_per_page, logical_block_size
         )
+        # Match the detector's HND/BLHNC interpretation. These are opaque
+        # pages with one synthetic head, so changing metadata keeps byte order.
+        if _layout_hints.get("kv_layout") in ("HND", "BLHNC"):
